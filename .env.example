PORT=4000
# Must point at a persistent volume in production
DB_PATH=./data/snippets.db
# Exact web origin: scheme + host + port, no trailing slash
CORS_ORIGIN=http://localhost:3000
# Admin key for PATCH/DELETE /snippets/:id (sent as "Authorization: Bearer <key>").
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Leave empty to disable edit/delete entirely.
ADMIN_KEY=
